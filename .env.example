# Credenciais da API Oficial do LinkedIn (Share on LinkedIn + OpenID Connect)
# 1. Crie um App gratuito em: https://www.linkedin.com/developers/apps
# 2. Em "Products", solicite "Share on LinkedIn" e "Sign In with LinkedIn using OpenID Connect"
# 3. Gere o token (escopos openid, profile, w_member_social) em:
#    https://www.linkedin.com/developers/tools/oauth/token-generator

LINKEDIN_ACCESS_TOKEN="cole_seu_access_token_aqui"

# Descubra com: node post_linkedin.mjs --whoami
LINKEDIN_PERSON_URN=""
